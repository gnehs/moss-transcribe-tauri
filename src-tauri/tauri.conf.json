{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOSS Transcribe Studio",
  "version": "0.1.0",
  "identifier": "com.gnehs.moss-transcribe-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBundleCommand": "pnpm run tauri:prepare-mlx",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "files": {
        "MacOS/mlx.metallib": "resources/mlx.metallib"
      }
    },
    "resources": ["Assets.car"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
